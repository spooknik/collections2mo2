# This file is optional. It is only for the developer overrides listed below; normal
# use needs none of them. Signing in is always `c2mo2 login` (or the GUI's "Sign in with
# Nexus Mods" button).

# Override the OAuth client id (for testing a differently registered application).
# C2MO2_NEXUS_CLIENT_ID=

# Override the loopback OAuth callback port (default 43119).
# C2MO2_OAUTH_PORT=43119
