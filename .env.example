# This file is optional and for developers/testing only. Normal users sign in with
# `c2mo2 login` (or the GUI's "Sign in with Nexus Mods" button) - Nexus's API
# Acceptable Use Policy doesn't allow public applications to use personal API keys.
#
# Personal API key from https://www.nexusmods.com/users/myaccount?tab=api+access
# Takes precedence over a stored sign-in when set. Testing only - do not rely on this
# in a shipped build.
NEXUS_API_KEY=

# Override the OAuth client id (for testing a differently registered application).
# C2MO2_NEXUS_CLIENT_ID=

# Override the loopback OAuth callback port (default 43119).
# C2MO2_OAUTH_PORT=43119
